{
  "name": "al-rifai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run test:unit && npm run test:standalone",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:import": "node scripts/database.mjs import",
    "db:verify": "node scripts/database.mjs verify",
    "db:install": "node --experimental-strip-types scripts/standalone/install.mjs",
    "db:preflight": "node --experimental-strip-types scripts/standalone/install.mjs --preflight",
    "test:domain": "node --experimental-strip-types --test --test-concurrency=1 tests/standalone/domain.test.ts",
    "test:whatsapp": "node --experimental-strip-types --test --test-concurrency=1 tests/standalone/whatsapp.test.ts",
    "test:standalone": "node --experimental-strip-types --test --test-concurrency=1 tests/standalone/domain.test.ts tests/standalone/whatsapp.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/shift-boundary.mjs tests/unified-auth-policy.mjs tests/standalone/media.test.mjs tests/standalone/identity.test.mjs",
    "admin:reset": "node --experimental-strip-types scripts/standalone/reset-password.mjs",
    "env:check": "node --experimental-strip-types scripts/check-env.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "@types/pg": "8.15.5"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
