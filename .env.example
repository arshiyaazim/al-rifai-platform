# AL-RIFA'I — standalone edition configuration
#
# Copy this file to .env next to package.json and restrict it:  chmod 600 .env
# Every value below is an EXAMPLE. Replace host, database, users and paths.
# Secrets are never placed here — only the path to a file that holds them.

# ── application ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── PostgreSQL connection (required) ──────────────────────────────────────────
# Host may be a DNS name, an IPv4/IPv6 address or a unix socket directory
# (e.g. /var/run/postgresql). No production default is assumed.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=alrifai
PGSCHEMA=public

# Owner role: creates and owns the schema, performs the migration baseline.
PGUSER=alrifai_owner
PGPASSWORD_FILE=/etc/alrifai/secrets/database_password

# ── least-privilege runtime role (required) ───────────────────────────────────
# Used by the application routes, the Cash portal and the review workflows.
# This role must NOT be a superuser and must not own the schema.
ALRIFAI_REVIEW_DB_USER=alrifai_runtime
ALRIFAI_REVIEW_PASSWORD_FILE=/etc/alrifai/secrets/review_runtime_password

# ── optional third role (WhatsApp mirror tooling — not used standalone) ───────
# ALRIFAI_MIRROR_WORKER_DB_USER=alrifai_mirror_worker
# ALRIFAI_MIRROR_WORKER_PASSWORD_FILE=/etc/alrifai/secrets/mirror_worker_password

# ── first administrator (used only by `pnpm db:install`) ─────────────────────
# Prefer the --admin-user / --admin-password flags so the password is not stored.
# ALRIFAI_ADMIN_USERNAME=owner
# ALRIFAI_ADMIN_PASSWORD=
# ALRIFAI_ADMIN_NAME=Owner

# ── authentication ────────────────────────────────────────────────────────────
# off | shadow | on   — 'on' enables the session login for the workspace.
ALRIFAI_UNIFIED_AUTH_MODE=on
# Exact public origins, comma separated, scheme + host, no trailing slash.
ALRIFAI_UNIFIED_ORIGINS=https://alrifai.example.com
# Comma-separated 64-hex user ids that are Super Admin (see README §6).
ALRIFAI_CASH_SUPER_ADMIN_IDS=
# Actor reference stamped on vessel commands and their audit events.
ALRIFAI_VESSEL_COMMAND_ACTOR=
# Public host of the Cash portal (used by the optional TLS entry).
ALRIFAI_CASH_ORIGIN=https://alrifai.example.com

# ── keep disabled in the standalone edition ───────────────────────────────────
ALRIFAI_LIVE_CASH_SYNC=0
ALRIFAI_MESSAGE_MIRROR_ENABLED=0
ALRIFAI_VESSEL_PROCESSING_ENABLED=0

# Legacy Basic guard (optional). Omit to disable that authentication path.
# ALRIFAI_VALIDATION_PASSWORD_FILE=/etc/alrifai/secrets/validation_password

# External integrations must stay unset:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# FAZLE_CORE_URL=
# FAZLE_CORE_READ_KEY=
# WHATSAPP_WA01_MCP_SOCKET=
# WHATSAPP_WA02_MCP_SOCKET=
