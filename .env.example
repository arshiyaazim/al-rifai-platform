# AL-RIFA'I — centralized configuration (EXAMPLE)
#
# Copy to `.env` in this directory and restrict it:  chmod 600 .env
# `.env` is the single configuration source for the web application, the
# installer, the importer and the sync worker. It is git-ignored and must never
# be committed. Every value below is a placeholder.
#
# Inside a container these keys arrive as environment variables (compose
# `env_file`); the same file is read directly when a script runs from the tree.
# A value already present in the environment always wins over the file.

# ── application ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── PostgreSQL: owner role (schema owner) ─────────────────────────────────────
# Host may be a DNS name, an IPv4/IPv6 address or a unix socket directory.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=alrifai_v2
PGSCHEMA=public
PGUSER=alrifai_app
# Inline secret (preferred: one file holds everything).
PGPASSWORD=replace-with-the-owner-password
# A mounted secret file is also accepted instead of PGPASSWORD:
# PGPASSWORD_FILE=/etc/alrifai/secrets/database_password

# ── PostgreSQL: least-privilege runtime role ──────────────────────────────────
# Used by the application routes, the Cash portal, the review workflows and the
# sync worker. It must NOT be a superuser and must not own the schema.
ALRIFAI_REVIEW_DB_USER=alrifai_v2_runtime
ALRIFAI_REVIEW_PASSWORD=replace-with-the-runtime-role-password
# ALRIFAI_REVIEW_PASSWORD_FILE=/etc/alrifai/secrets/review_runtime_password

# ── authentication ────────────────────────────────────────────────────────────
# off | shadow | on — 'on' enables session login for the workspace.
ALRIFAI_UNIFIED_AUTH_MODE=on
# Exact public origins, comma separated. Scheme + host, no trailing slash.
ALRIFAI_UNIFIED_ORIGINS=https://app.example.com
# Public origin of the Cash portal.
ALRIFAI_CASH_ORIGIN=https://app.example.com
# Optional: comma-separated 64-hex user ids treated as Super Admin.
# ALRIFAI_CASH_SUPER_ADMIN_IDS=

# ── first administrator (used only by a fresh `pnpm db:install`) ─────────────
# Set these before the very first install. After that, use `pnpm admin:reset`.
ALRIFAI_BOOTSTRAP_ADMIN_USERNAME=owner
ALRIFAI_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ALRIFAI_BOOTSTRAP_ADMIN_NAME=Owner

# ── WhatsApp ingestion (bridge stores, read-only) ────────────────────────────
# Absolute paths to each bridge's persisted message store. The container
# overrides these two paths to its own mounts (/wa/wa-01, /wa/wa-02).
WA01_ID=wa-01
WA01_LABEL=WhatsApp account 1
WA01_DB=/var/lib/vps/whatsapp/wa-01/store/messages.db
WA02_ID=wa-02
WA02_LABEL=WhatsApp account 2
WA02_DB=/var/lib/vps/whatsapp/wa-02/store/messages.db

# Sync tuning (optional).
SYNC_INTERVAL_MS=5000
SYNC_BATCH=400
SYNC_RECENT_WINDOW=300
SYNC_RECENT_EVERY=12

# ── optional integrations (keep disabled unless requested) ───────────────────
ALRIFAI_LIVE_CASH_SYNC=0
ALRIFAI_MESSAGE_MIRROR_ENABLED=0
ALRIFAI_VESSEL_PROCESSING_ENABLED=0
# Optional continuous Phase 3 router. The DB activation gate is still required:
#   app_settings.phase3_router_enabled = true
#   app_settings.phase3_cutover_rowid:<account> = <non-negative integer>
#   app_settings.phase3_business_chats:<account> = [<approved chat JIDs>]
# Keep disabled until the Owner supplies the approved chats/participants and the
# cutover watermark. No outbound sender and no automatic financial posting.
PHASE3_ROUTER_WORKER_ENABLED=0
PHASE3_ROUTER_WORKER_INTERVAL_MS=5000
PHASE3_ROUTER_WORKER_LIMIT=100

# WA-02 AI communication (default disabled). Activation also requires the DB
# gate app_settings.ai_wa02_enabled=true and an explicit ai_wa02_start_rowid:wa-02.
AI_WA02_ENABLED=0
AI_OUTBOUND_ENABLED=0
AI_WA02_INTERVAL_MS=5000
AI_WA02_LIMIT=25

# Leave unset in this edition:
# OPENAI_API_KEY=
# OPENAI_MODEL=
# FAZLE_CORE_URL=
# FAZLE_CORE_READ_KEY=
# WHATSAPP_WA01_MCP_SOCKET=
# WHATSAPP_WA02_MCP_SOCKET=

# ── new-media capture ────────────────────────────────────────────────────────
# Captured attachments are stored outside the image and the Git checkout. The
# compose file mounts the host directory at /media for both services.
ALRIFAI_MEDIA_ENABLED=1
ALRIFAI_MEDIA_DIR=/media
# Hard ceiling for one attachment (25 MB by default).
ALRIFAI_MEDIA_MAX_BYTES=26214400
ALRIFAI_MEDIA_TIMEOUT_MS=20000
# Owner of the written files. The container worker runs as root so it can read
# the 0700 bridge store; files are handed to the app user after writing.
ALRIFAI_MEDIA_UID=10001
ALRIFAI_MEDIA_GID=10001

# ── TLS entry (deploy/tls-entry.mjs) ─────────────────────────────────────────
# Certificate paths inside the container; the pair is mounted read-only.
TLS_KEY_FILE=/etc/alrifai/tls/private-entry.key
TLS_CERT_FILE=/etc/alrifai/tls/private-entry.crt
TLS_PORT=3443
