+test('the same content sent twice in one chat is one logical order, two evidence rows', () => {
+  const ops = derive([
+    message('dup-1', FRAGMENT_B, '2026-11-03T05:39:37+00:00'),
+    message('dup-2', FRAGMENT_B, '2026-11-03T05:41:00+00:00'),
